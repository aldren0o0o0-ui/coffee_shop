APP_NAME=Coffee Shop Management System
APP_ENV=development
DEBUG=false

DATABASE_URL=postgresql+psycopg://database_user:database_password@localhost:5432/coffee_shop_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

FRONTEND_URL=http://localhost:5173

SECRET_KEY=generate-a-random-secret-for-your-environment

SESSION_COOKIE_NAME=ldrndc_session
SESSION_LIFETIME_HOURS=8
# Set SESSION_COOKIE_SECURE=true when deployed behind HTTPS in production
SESSION_COOKIE_SECURE=false